# --- Required ---------------------------------------------------------------
# Run `npm run setup` once: it creates .env.local with fresh secrets and a login for you.
ADMIN_EMAIL=you@example.com
# scrypt hash made by `npm run hash-password -- "your password"` (never store the plain password)
ADMIN_PASSWORD_HASH=
# 32+ random characters; signs the login cookie
SESSION_SECRET=
# Ed25519 keypair (base64 of the PEM) made by `npm run gen-keys`. The private key signs
# licence answers; the public key goes into every client project.
LICENSE_PRIVATE_KEY_B64=
LICENSE_PUBLIC_KEY_B64=

# --- Database ---------------------------------------------------------------
# Local development uses a SQLite file automatically. For Vercel use a free Turso database:
#   DATABASE_URL=libsql://your-db.turso.io
#   DATABASE_AUTH_TOKEN=...
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# --- Optional ---------------------------------------------------------------
# Protects /api/cron/health (Vercel sends it automatically when set)
CRON_SECRET=
